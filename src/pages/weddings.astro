---
import Base from '../layouts/Base.astro';
---
<Base title="Aurora Wedding Venue in Fairbanks — Lundemo Lodge | Alaska Dream Vacation" description="Say 'I do' under the northern lights at Lundemo Lodge, an intimate aurora wedding & elopement venue near Fairbanks, Alaska. Packages, capacity, and inquiries.">
  <!-- HERO -->
  <section class="whero">
    <div class="bg scene s3"><div class="stars-lite"></div></div>
    <div class="wrap content">
      <span class="eyebrow">Weddings & elopements · Lundemo Lodge</span>
      <h1 style="font-size:clamp(34px,6vw,64px);margin:20px 0 14px;max-width:16ch">Say "I do" under the <span style="background:linear-gradient(120deg,var(--aurora-green),var(--aurora-violet));-webkit-background-clip:text;background-clip:text;color:transparent">northern lights.</span></h1>
      <p style="color:var(--muted);font-size:19px;max-width:48ch">Lundemo Lodge is our four-bedroom aurora home turned intimate wedding venue — wide dark skies, a warm lodge for your party, and the most unforgettable backdrop on Earth.</p>
      <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="#inquire">Check your date</a>
        <a class="btn btn-ghost" href="/homes/lundemo-lodge">See the lodge</a>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="block wrap">
    <div class="sec-head"><span class="eyebrow">Why Lundemo</span><h2>An aurora venue that sleeps your whole party.</h2><p>Minutes from downtown Fairbanks, dark enough for the lights, and warm enough for a winter celebration.</p></div>
    <div class="props">
      <div class="prop"><div class="ic">🌌</div><h3>Aurora backdrop</h3><p>North-facing, low light pollution — ceremony photos with the real northern lights overhead.</p></div>
      <div class="prop"><div class="ic">🛏️</div><h3>Sleeps the party</h3><p>Four bedrooms plus a great room, so the couple and closest guests stay on-site together.</p></div>
      <div class="prop"><div class="ic">👥</div><h3>Intimate scale</h3><p>Perfect for elopements and small weddings — up to about 30 seated indoors, more in the yard.</p></div>
      <div class="prop"><div class="ic">📸</div><h3>Vendors on call</h3><p>We connect you with an aurora photographer, officiant, florals, and catering.</p></div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="wrap" style="padding-bottom:24px">
    <div class="gallery">
      <div class="big scene s1"><div class="stars-lite"></div></div>
      <div class="scene s3"></div><div class="scene s2"></div><div class="scene s2"></div><div class="scene s1"></div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="block wrap">
    <div class="sec-head"><span class="eyebrow">Packages</span><h2>Three ways to celebrate.</h2><p>Starting points — every celebration is tailored with you. Prices are venue + coordination; add-on vendors quoted separately.</p></div>
    <div class="pkg">
      <div class="p">
        <h3>Aurora Elopement</h3>
        <div class="price">$1,900 <small>/ just the two of you</small></div>
        <ul>
          <li><span class="chk">✓</span> 2-night stay at Lundemo Lodge</li>
          <li><span class="chk">✓</span> Ceremony setup & aurora viewing deck</li>
          <li><span class="chk">✓</span> Officiant coordination</li>
          <li><span class="chk">✓</span> 1-hour aurora photo session</li>
        </ul>
        <a class="btn btn-ghost" href="#inquire">Inquire</a>
      </div>
      <div class="p feat">
        <h3>Intimate Wedding <span class="pilltag hot" style="margin-left:6px">Most popular</span></h3>
        <div class="price">$4,500 <small>/ up to 20 guests</small></div>
        <ul>
          <li><span class="chk">✓</span> 3-night full-lodge buyout</li>
          <li><span class="chk">✓</span> Indoor + outdoor ceremony options</li>
          <li><span class="chk">✓</span> Day-of coordinator</li>
          <li><span class="chk">✓</span> Photographer + officiant included</li>
          <li><span class="chk">✓</span> Catering & florals arranged</li>
        </ul>
        <a class="btn btn-primary" href="#inquire">Inquire</a>
      </div>
      <div class="p">
        <h3>Winter Celebration</h3>
        <div class="price">Custom <small>/ up to ~30 guests</small></div>
        <ul>
          <li><span class="chk">✓</span> Multi-night buyout + nearby rooms</li>
          <li><span class="chk">✓</span> Full vendor team & rentals</li>
          <li><span class="chk">✓</span> Welcome dinner & activities (dog sledding, hot springs)</li>
          <li><span class="chk">✓</span> Custom timeline around the aurora</li>
        </ul>
        <a class="btn btn-ghost" href="#inquire">Inquire</a>
      </div>
    </div>
  </section>

  <!-- INQUIRE -->
  <section class="block wrap" id="inquire" style="padding-top:0">
    <div class="cta-band"><div class="bg"></div>
      <h2>Check your wedding date at Lundemo</h2>
      <p>Tell us your dates and guest count and we'll send availability, a full package sheet, and vendor options within a day.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:6px">
        <a class="btn btn-primary" href="mailto:weddings@alaskadreamvacation.com?subject=Lundemo%20wedding%20inquiry">Email our wedding team</a>
        <a class="btn btn-ghost" href="/about">Contact</a>
      </div>
    </div>
  </section>
</Base>
