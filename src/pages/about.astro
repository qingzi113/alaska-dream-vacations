---
import Base from '../layouts/Base.astro';
---
<Base title="About & Contact | Alaska Dream Vacation" description="Locally hosted aurora-view homes in Fairbanks & North Pole, Alaska. Meet the team and get in touch.">
  <section class="block wrap" style="padding-top:48px">
    <span class="eyebrow">About us</span>
    <h1 style="font-size:clamp(30px,5vw,52px);margin:16px 0 14px;max-width:22ch">Locally hosted, directly booked.</h1>
    <p style="color:var(--muted);font-size:18px;max-width:62ch">Alaska Dream Vacation is a family of spacious, high-end aurora homes across Fairbanks and North Pole, cared for by a local Alaska team. We built this site so you can book direct — skip the OTA fees, and get real local help before and during your stay. <em>(Placeholder copy — we'll replace with your story, photos, and contact details.)</em></p>

    <div class="split" style="margin-top:48px">
      <div class="media scene s2"><div class="stars-lite"></div><div class="glow"></div></div>
      <div>
        <h2 style="font-size:28px;margin-bottom:12px">Get in touch</h2>
        <p style="color:var(--muted)">Questions about a stay, group bookings, or listing your property with us?</p>
        <ul style="list-style:none;margin-top:20px;display:flex;flex-direction:column;gap:12px">
          <li>✉️ <a href="mailto:hello@alaskadreamvacation.com" style="color:var(--aurora-green)">hello@alaskadreamvacation.com</a></li>
          <li>📞 <span style="color:var(--ink)">(907) 000-0000 — add your number</span></li>
          <li>📍 Fairbanks & North Pole, Alaska</li>
        </ul>
        <div style="margin-top:26px"><a class="btn btn-primary" href="/#homes">Browse homes</a></div>
      </div>
    </div>
  </section>
</Base>
